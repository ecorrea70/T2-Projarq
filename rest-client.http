@baseUrl = http://localhost:8000
# Copie SYNC_API_TOKEN do seu .env local
@token = coloque-o-token-aqui

### Saúde (pública)
GET {{baseUrl}}/health

### Iniciar sync de professores (gateway gera correlation_id automático)
# @name syncTeachers
POST {{baseUrl}}/sync/teachers
Authorization: Bearer {{token}}

### Acompanhar sync de professores
GET {{baseUrl}}/sync/{{syncTeachers.response.body.correlation_id}}
Authorization: Bearer {{token}}

### Iniciar sync de alunos (gateway gera correlation_id automático)
# @name syncStudents
POST {{baseUrl}}/sync/students
Authorization: Bearer {{token}}

### Acompanhar sync de alunos
GET {{baseUrl}}/sync/{{syncStudents.response.body.correlation_id}}
Authorization: Bearer {{token}}

### Métricas do gateway
GET {{baseUrl}}/metrics
