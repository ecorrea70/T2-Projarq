# ==========================================
# T2 — Integração i-Educar × Moodle (Microsserviços)
# ==========================================
# Copie para .env (`cp .env.example .env`) e preencha os valores obrigatórios.

# --- RabbitMQ (Broker) ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Moodle (Instância / Container) ---
MOODLE_DB_NAME=bitnami_moodle
MOODLE_DB_USER=bn_moodle
MOODLE_DB_PASSWORD=
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_HTTP_PORT=8080
MOODLE_HTTPS_PORT=8443

# --- Moodle Integration (Consumido pelo moodle-service) ---
MOODLE_URL=http://moodle:8080
MOODLE_TOKEN=
MOODLE_CATEGORY_ID=1
MOODLE_TEACHER_ROLE_ID=3
MOODLE_STUDENT_ROLE_ID=5

# --- moodle-service ---
MOODLE_SERVICE_PORT=8003
MOODLE_SERVICE_DB_NAME=moodle_service
MOODLE_SERVICE_DB_USER=moodle_service
MOODLE_SERVICE_DB_PASSWORD=moodle_service
MOODLE_CONNECT_TIMEOUT=5
MOODLE_READ_TIMEOUT=15
LOCAL_MAX_RETRIES=2
LOCAL_RETRY_BASE_DELAY=1.0
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_TTL_MS=10000
RABBITMQ_PREFETCH_COUNT=5
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_SECONDS=30

# --- i-Educar (Instância Real / Submodule services/i-educar) ---
IEDUCAR_HTTP_PORT=8081
IEDUCAR_DB_NAME=ieducar
IEDUCAR_DB_USER=ieducar
IEDUCAR_DB_PASSWORD=ieducar
# UID/GID do seu usuário, para os arquivos do submodule não virarem root:
IEDUCAR_HOST_UID=1001
IEDUCAR_HOST_GID=1001
# Caminho alternativo do checkout do i-Educar (padrão: ./services/i-educar):
# IEDUCAR_PATH=./services/i-educar

# --- i-Educar Integration (consumido pelo ieducar-service) ---
IEDUCAR_INTERNAL_URL=http://ieducar
IEDUCAR_TOKEN=
IEDUCAR_ACCESS_KEY=
IEDUCAR_SCHOOL_ID=2,3
IEDUCAR_YEAR=2026
IEDUCAR_CONNECT_TIMEOUT=5
IEDUCAR_READ_TIMEOUT=30

# --- ieducar-service ---
IEDUCAR_SERVICE_PORT=8004
IEDUCAR_SERVICE_DB_NAME=ieducar_service
IEDUCAR_SERVICE_DB_USER=ieducar_service
IEDUCAR_SERVICE_DB_PASSWORD=ieducar_service
# Intervalo da varredura automática da origem e varredura na subida:
SCAN_INTERVAL_SECONDS=60
SCAN_ON_STARTUP=true

# --- api-gateway (borda pública) ---
API_GATEWAY_PORT=8000
SYNC_API_TOKEN=

# --- sync-service ---
SYNC_SERVICE_PORT=8002
SYNC_SERVICE_DB_NAME=sync_service
SYNC_SERVICE_DB_USER=sync_service
SYNC_SERVICE_DB_PASSWORD=sync_service
IEDUCAR_SOURCE=mock
# Quando o ieducar-service estiver pronto: IEDUCAR_SOURCE=http
IEDUCAR_SERVICE_URL=http://ieducar-service:8004
MOODLE_SETUP_CHECK_ENABLED=true
INSTITUTION_ID=1
SYNC_LOCK_SCOPE=global

# --- Injeção de Falha Controlada (Demonstração do Cenário 3) ---
FAULT_INJECT_DROP_AFTER_COURSE_CREATE=false
FAULT_INJECT_TARGET_IDNUMBER=

